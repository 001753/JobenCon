# =============================================================
# JOBEN CONNECT — Environment Variables Template
# Copy ke .env dan isi nilainya. Jangan commit .env ke git.
# =============================================================

# --- Database ---
# PostgreSQL connection URL (auto-provided oleh Replit PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/jobencon?schema=public"

# --- JWT & Session ---
# Minimum 32 karakter, gunakan: openssl rand -base64 48
JWT_SECRET="GANTI_DENGAN_SECRET_KUAT_MINIMUM_32_KARAKTER"
JWT_REFRESH_SECRET="GANTI_DENGAN_REFRESH_SECRET_KUAT_BERBEDA"
SESSION_SECRET="GANTI_DENGAN_SESSION_SECRET_KUAT"

# JWT expiry
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Redis ---
# Redis connection URL
REDIS_URL="redis://localhost:6379"

# --- Auth Service ---
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_HOST="0.0.0.0"
AUTH_SERVICE_INTERNAL_SECRET="SECRET_UNTUK_INTERNAL_SERVICE_CALLS"

# --- API Gateway ---
API_GATEWAY_PORT=3000
API_GATEWAY_HOST="0.0.0.0"

# --- Email (SendGrid) ---
SENDGRID_API_KEY="SG.xxxx"
EMAIL_FROM="noreply@jobenconnect.id"
EMAIL_FROM_NAME="Joben Connect"

# --- Application ---
NODE_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# --- Security ---
# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
