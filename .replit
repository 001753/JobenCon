modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
API_GATEWAY_HOST = "0.0.0.0"
API_GATEWAY_PORT = "3000"
AUTH_SERVICE_HOST = "0.0.0.0"
AUTH_SERVICE_PORT = "3001"
AUTH_SERVICE_URL = "http://localhost:3001"
CORS_ORIGINS = "http://localhost:3000,http://localhost:5173"
JWT_EXPIRES_IN = "15m"
LOG_LEVEL = "info"
NODE_ENV = "development"
RATE_LIMIT_MAX = "100"
RATE_LIMIT_WINDOW_MS = "60000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Gateway"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auth Service"

[[workflows.workflow]]
name = "API Gateway"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev:gateway"
waitForPort = 3000

[[workflows.workflow]]
name = "Auth Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev:auth"
waitForPort = 3001

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001
